{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/login",
      "destination": "https://portal.sonarismedical.com/",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/why-us/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/why-us/",
      "permanent": true
    },
    {
      "source": "/our-story",
      "destination": "/why-us/",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/resources/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/resources/",
      "permanent": true
    },
    {
      "source": "/articles/:path*",
      "destination": "/resources/",
      "permanent": true
    },
    {
      "source": "/programs",
      "destination": "/clinical-education/",
      "permanent": true
    },
    {
      "source": "/programs/:path*",
      "destination": "/clinical-education/",
      "permanent": true
    },
    {
      "source": "/clinical-training",
      "destination": "/clinical-education/",
      "permanent": true
    },
    {
      "source": "/partners",
      "destination": "/schools/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portal-terms",
      "destination": "/portal-terms/",
      "permanent": true
    },
    {
      "source": "/data-security",
      "destination": "/data-and-access/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/clinical-placement-planning-guide",
      "destination": "/resources/clinical-placement-planning-guide/",
      "permanent": true
    },
    {
      "source": "/blog-clinical-site",
      "destination": "/resources/blog-clinical-site/",
      "permanent": true
    },
    {
      "source": "/ultrasound-clinical-placement",
      "destination": "/resources/ultrasound-clinical-placement/",
