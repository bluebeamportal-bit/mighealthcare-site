    },
    {
      "source": "/blog-placement-shortage",
      "destination": "/resources/blog-placement-shortage/",
      "permanent": true
    },
    {
      "source": "/blog-day-in-life",
      "destination": "/resources/blog-day-in-life/",
      "permanent": true
    },
    {
      "source": "/blog-mri-salary",
      "destination": "/resources/blog-mri-salary/",
      "permanent": true
    },
    {
      "source": "/blog-choosing-program",
      "destination": "/resources/blog-choosing-program/",
