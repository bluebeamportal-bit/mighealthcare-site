      "permanent": true
    },
    {
      "source": "/ultrasound-student-readiness",
      "destination": "/resources/ultrasound-student-readiness/",
      "permanent": true
    },
    {
      "source": "/ultrasound-progress-reporting",
      "destination": "/resources/ultrasound-progress-reporting/",
      "permanent": true
    },
    {
      "source": "/ultrasound-patient-communication",
      "destination": "/resources/ultrasound-patient-communication/",
      "permanent": true
    },
    {
      "source": "/ultrasound-image-review",
      "destination": "/resources/ultrasound-image-review/",
      "permanent": true
    },
    {
      "source": "/ultrasound-clinical-teamwork",
      "destination": "/resources/ultrasound-clinical-teamwork/",
      "permanent": true
    },
    {
      "source": "/blog-mri-safety",
      "destination": "/resources/blog-mri-safety/",
